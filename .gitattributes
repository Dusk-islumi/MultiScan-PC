# Keep the repository consistent across Windows / macOS / Linux.
* text=auto

*.kt    text
*.kts   text
*.java  text
*.xml   text
*.md    text
*.cs    text
*.csproj text
*.yml   text
*.yaml  text
*.toml  text

# Shell / Gradle wrapper must stay LF; Windows scripts need CRLF.
gradlew   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf

# Binary artifacts
*.jar     binary
*.apk     binary
*.aab     binary
*.exe     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.so      binary
